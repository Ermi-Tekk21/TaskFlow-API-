PORT=8000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=taskflow_db

# Alternative DATABASE_URL if preferred
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskflow_db

# JWT Configuration
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=1d

NODE_ENV=development

# Rate Limiting & Throttler Configuration
THROTTLE_SHORT_TTL=10000
THROTTLE_SHORT_LIMIT=10
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_BLOCK_DURATION=60000

# Brute Force Protection Configuration
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_MINUTES=15
BRUTE_FORCE_IP_MAX_ATTEMPTS=10
BRUTE_FORCE_IP_WINDOW_MINUTES=10
BRUTE_FORCE_IP_BLOCK_MINUTES=15
